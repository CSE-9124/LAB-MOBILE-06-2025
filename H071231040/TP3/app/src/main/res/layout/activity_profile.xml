<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:backgroundTint="@color/black"
    tools:context=".ProfileActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Profile Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:padding="16dp">

                <TextView
                    android:id="@+id/username"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/username"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"/>

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/profile_image"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_below="@id/username"
                    android:layout_marginTop="10dp"
                    android:src="@drawable/gojo"
                    app:civ_border_width="1dp"
                    app:civ_border_color="#E0E0E0"/>

                <TextView
                    android:id="@+id/real_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/username"
                    android:layout_toEndOf="@id/profile_image"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/real_name"
                    android:textSize="16sp"
                    android:textColor="@color/white"/>

                <LinearLayout
                    android:id="@+id/post"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/real_name"
                    android:layout_toEndOf="@id/profile_image"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="10dp"
                    android:paddingHorizontal="3dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/post_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/post_count"
                        android:textSize="16sp"
                        android:textColor="@color/white"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="@string/postingan"
                        android:textSize="15sp"
                        android:textColor="@color/white"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/followers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/real_name"
                    android:layout_toEndOf="@id/post"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="10dp"
                    android:paddingHorizontal="3dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/followers_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/followers_count"
                        android:textSize="16sp"
                        android:textColor="@color/white"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="@string/pengikut"
                        android:textSize="15sp"
                        android:textColor="@color/white"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/following"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/real_name"
                    android:layout_toEndOf="@id/followers"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="10dp"
                    android:paddingHorizontal="3dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/following_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/following_count"
                        android:textSize="16sp"
                        android:textColor="@color/white"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="@string/mengikuti"
                        android:textSize="15sp"
                        android:textColor="@color/white"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/bio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/profile_image"
                    android:layout_marginTop="10dp"
                    android:text="@string/bio"
                    android:textColor="@color/white"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/edit_profile_button"
                    android:layout_width="160dp"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/bio"
                    android:layout_marginTop="5dp"
                    android:padding="0dp"
                    android:text="@string/edit_profile_btn"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/dark_gray"
                    app:cornerRadius="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/share_profile_button"
                    android:layout_width="160dp"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/edit_profile_button"
                    android:layout_below="@id/bio"
                    android:layout_marginTop="5dp"
                    android:layout_marginStart="10dp"
                    android:padding="0dp"
                    android:text="@string/bagikan_profile_btn"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/dark_gray"
                    app:cornerRadius="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/add_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/share_profile_button"
                    android:layout_below="@id/bio"
                    android:layout_marginTop="5dp"
                    android:layout_marginStart="10dp"
                    android:padding="0dp"
                    android:text=""
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:backgroundTint="@color/dark_gray"
                    app:cornerRadius="8dp"
                    app:icon="@drawable/ic_add"
                    app:iconGravity="textStart"
                    app:iconTint="@color/white"
                    app:iconPadding="0dp"/>
            </RelativeLayout>

            <!-- Highlights -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/highlights_recycler_view"
                android:layout_width="wrap_content"
                android:layout_height="100dp"
                android:paddingHorizontal="8dp"/>

            <!-- Posts Grid -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/posts_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="10dp"
                android:padding="2dp"/>

        </LinearLayout>

    </ScrollView>

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:menu="@menu/menu_main"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="@color/dark_gray"/>

</androidx.constraintlayout.widget.ConstraintLayout>